@{
    string? current = ViewContext.RouteData.Values["page"]?.ToString();
    bool IsActive(string page) => string.Equals(current, page, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="zh-Hans">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · VelaShell Feeds</title>
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
<header class="topbar">
    <div class="brand">
        <span class="dot"></span>
        <span>VelaShell Feeds</span>
    </div>
    <nav>
        <a href="/admin" class="@(IsActive("/Admin/Index") ? "active" : "")">概览</a>
        <a href="/admin/entries" class="@(IsActive("/Admin/Entries") ? "active" : "")">公告与广告</a>
        <a href="/admin/advisories" class="@(IsActive("/Admin/Advisories") ? "active" : "")">漏洞公告</a>
        <a href="/admin/preview" class="@(IsActive("/Admin/Preview") ? "active" : "")">feed 预览</a>
    </nav>
    <div class="who">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span>@(User.Identity!.Name ?? User.FindFirst("sub")?.Value)</span>
            <form method="post" action="/signout">
                <button type="submit" class="link">退出</button>
            </form>
        }
    </div>
</header>
<main>
    @RenderBody()
</main>
<footer>
    <span>投放的内容会被 VelaShell 客户端的消息中心拉走 —— 发布前请在「feed 预览」里确认一遍实际下发结果。</span>
</footer>
</body>
</html>
