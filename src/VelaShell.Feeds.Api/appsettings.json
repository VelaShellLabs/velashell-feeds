{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mongo": "mongodb://localhost:27017/velashell-feeds"
  },
  "Auth": {
    "Issuer": "http://localhost:7020",
    "Authority": "",
    "ClientId": "velashell-feeds-admin",
    "ClientSecret": "",
    "Scope": "velashell-feeds",
    "RequireHttpsMetadata": false,
    "AdminSubjects": []
  },
  "Feed": {
    "MaxItems": 100,
    "MaxCveItems": 40,
    "CveLifetimeDays": 30,
    "MinCvssScore": 7.0
  },
  "Cve": {
    "Enabled": true,
    "IntervalHours": 6,
    "KevEnabled": true,
    "NvdEnabled": true,
    "NvdApiKey": "",
    "NvdMinCvss": 7.0,
    "NvdLookbackDays": 7
  }
}
