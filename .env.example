# ---- 复用生态里已有的基础设施 ----
# MongoDB(与市场同一个副本集,不同数据库)
MONGO_ROOT_USER=market
MONGO_ROOT_PASSWORD=change-me-please

# 统一认证服务。IDENTITY_ISSUER 必须是**浏览器能打开**的地址。
IDENTITY_ISSUER=https://auth.easilynet.top
# 只有"浏览器看到的地址"与"feeds 容器能访问到的地址"不同时才填。
IDENTITY_INTERNAL=

# ---- 本服务 ----
FEEDS_PORT=7030
REQUIRE_HTTPS=true
ASPNETCORE_ENVIRONMENT=Production

# 在认证服务里注册的客户端。管理台有后端,是机密客户端,应当配 secret。
FEEDS_CLIENT_ID=velashell-feeds-admin
FEEDS_CLIENT_SECRET=

# ---- 管理员白名单 ----
# 留空 = 管理台谁都进不去(这是有意的:没配置好的服务不该默认放行)。
# 拿 sub 的办法:用管理员账号登录一次 https://feeds.easilynet.top/admin,
# 被拒的那一页会把你的 sub 显示出来。
ADMIN_SUBJECT_0=
ADMIN_SUBJECT_1=

# ---- CVE 采集 ----
CVE_ENABLED=true
CVE_INTERVAL_HOURS=6
# 可选。不填也能用,但 NVD 限流严得多(30 秒 5 次 vs 50 次)。
# 申请:https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
